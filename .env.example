APP_NAME=Electrik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Public site URL for canonical tags, sitemap, and static export.
APP_PRODUCTION_URL=https://electrik.dev
APP_LOCAL_URL=http://localhost:8000

APP_TAGLINE="Laravel SaaS starter kit"
ELECTRIK_VERSION=5.0.0-alpha.15
ELECTRIK_DEMO_URL=https://demo.electrik.dev
ELECTRIK_COMMERCIAL_EMAIL=hello@electrik.dev
LEGAL_CONTACT_EMAIL=hello@electrik.dev

# Dodo Payments (commercial license checkout — preferred over Stripe for www).
# Test mode API key from dashboard. Never commit real keys. Never put API key in Pages.
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_...   # Pages secret only
# Static Payment Links (baked at export):
# DODO_CHECKOUT_SOLO=https://test.checkout.dodopayments.com/buy/pdt_...?redirect_url=...
# DODO_CHECKOUT_STUDIO=https://test.checkout.dodopayments.com/buy/pdt_...?redirect_url=...
# Commerce ops (Pages secrets):
# COMMERCE_ADMIN_TOKEN=
# AWS_ACCESS_KEY_ID=          # SES — same IAM as demo (Pages secrets)
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-south-1
# MAIL_FROM_ADDRESS=hello@electrik.dev
# MAIL_FROM_NAME=Electrik
# COMMERCE_OPS_EMAIL=hello@electrik.dev

# Legacy Stripe Payment Links (optional fallback; leave empty if using Dodo).
# STRIPE_CHECKOUT_SOLO=https://buy.stripe.com/...
# STRIPE_CHECKOUT_STUDIO=https://buy.stripe.com/...

STUDIO_NAME="Quick Brown Fox"
STUDIO_URL=https://quickbrownfox.io
STUDIO_EMAIL=hello@electrik.dev

# Google Analytics (gtag.js). Baked into static export at deploy time.
GOOGLE_ANALYTICS_MEASUREMENT_ID=G-ZWCWJY4FWD

# Google AdSense (docs right rail). Leave empty to disable.
# ADSENSE_CLIENT_ID=ca-pub-4533175894495099
# ADSENSE_DOCS_SLOT=9851042810

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@electrik.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Kit (ConvertKit) — legacy; do not use for new Electrik list mail
# KIT_API_KEY=
# KIT_FORM_ID=
# KIT_FORM_UID=
# KIT_NEWSLETTER_ENABLED=false

# Listmonk (primary list + campaigns — SES via campaigns.quickbrownfox.io)
# LISTMONK_URL=https://campaigns.quickbrownfox.io
# LISTMONK_API_USER=
# LISTMONK_API_TOKEN=
# LISTMONK_LIST_ID=           # Electrik list (not Terminal Brief)
# LISTMONK_TEMPLATE_ID=9      # Raw / passthrough
# LISTMONK_NEWSLETTER_ENABLED=true

# Mailchimp — DISABLED (account blocked). Do not enable.
# MAILCHIMP_NEWSLETTER_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
