APP_NAME=Electrik
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Public site URL for canonical tags, sitemap, and static export.
APP_PRODUCTION_URL=https://electrik.dev
APP_LOCAL_URL=http://localhost:8000

APP_TAGLINE="Laravel SaaS starter kit"
ELECTRIK_VERSION=5.0.0-alpha.15
ELECTRIK_DEMO_URL=https://demo.electrik.dev
ELECTRIK_COMMERCIAL_EMAIL=hello@electrik.dev
LEGAL_CONTACT_EMAIL=hello@electrik.dev

STUDIO_NAME="Quick Brown Fox"
STUDIO_URL=https://quickbrownfox.io
STUDIO_EMAIL=hello@electrik.dev

# Google Analytics (gtag.js). Leave empty to disable.
# GOOGLE_ANALYTICS_MEASUREMENT_ID=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@electrik.dev"
MAIL_FROM_NAME="${APP_NAME}"

# Kit (ConvertKit) — list mail + site newsletter (never commit real keys)
# KIT_API_KEY=
# KIT_FORM_ID=
# KIT_FORM_UID=
# KIT_NEWSLETTER_ENABLED=true

# Mailchimp — DISABLED (account blocked). Do not enable.
# MAILCHIMP_NEWSLETTER_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
