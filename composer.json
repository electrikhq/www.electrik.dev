{
    "name": "electrik/www.electrik.dev",
    "type": "project",
    "description": "Marketing site for electrik.dev — the Electrik Laravel SaaS starter kit",
    "keywords": ["laravel", "saas", "starter-kit", "electrik"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "electrik/slate": "^3.0",
        "electrik/slate-blocks": "^0.1",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10",
        "spatie/laravel-export": "^1.1",
        "spatie/laravel-markdown": "^2.5",
        "spatie/laravel-sitemap": "^7.2",
        "spatie/yaml-front-matter": "^2.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/electrikhq/slate-blocks.git"
        }
    ],
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "*",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "*",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "files": [
            "app/Helpers/site.php",
            "app/Helpers/docs_page.php",
            "app/Helpers/legal_page.php",
            "app/Helpers/generate_sidebar.php",
            "app/Helpers/generate_table_of_contents.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd\" \"php artisan serve\" \"npm run dev\" --names=server,vite --kill-others"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ],
            "recurse": false,
            "replace": false,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": false
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
